# Aliza Flowers: Linux (Apache/LiteSpeed) hostinq üçün

RewriteEngine On

# SSL sertifikatının yoxlama faylları yönləndirilmir
RewriteRule ^\.well-known/ - [L]

# Həmişə https://aliza.az (www-suz)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://aliza.az%{REQUEST_URI} [L,R=301]

# /shop, /product/... kimi səhifələr yenilənəndə 404 olmasın
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Şəkillər və fayl adında hash olan JS/CSS uzun müddət keşlənir
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
