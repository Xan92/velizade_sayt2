# Bu faylı .env.deploy adı ilə kopyalayın və hostinq panelindəki FTP məlumatlarını yazın.
# .env.deploy GitHub-a yüklənmir.

# Domen hostinqə yönələnə qədər serverin IP ünvanını yazın, sonra ftp.aliza.az da olar
FTP_HOST=
FTP_USER=
FTP_PASSWORD=

# DirectAdmin-də əsas hesabla girəndə saytın qovluğu budur
FTP_DIR=domains/aliza.az/public_html
